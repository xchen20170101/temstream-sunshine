# EditorConfig helps maintain consistent coding styles across editors.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,xml,html,md}]
indent_style = space
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.{bat,cmd}]
indent_style = tab
indent_size = 4

[*.ps1]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.{c,h,cc,cpp,hpp}]
indent_style = tab
indent_size = 4

[*.{vue,js,ts,jsx,tsx,css,scss,sass,less}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
