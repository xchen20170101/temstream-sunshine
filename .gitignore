# Allow NSIS build scripts to be tracked
!Sunshine-0.21.0/pkg/*.bat
!Sunshine-0.21.0/pkg/*.ps1
!Sunshine-0.21.0/pkg/*.nsi
# NSIS build output
Sunshine-0.21.0/pkg/build-nsis/
Sunshine-0.21.0/pkg/dist/

Sunshine-0.21.0/config_tool_python/**/*.pyc

