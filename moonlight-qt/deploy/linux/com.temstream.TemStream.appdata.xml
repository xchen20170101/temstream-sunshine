  <name>TemStream</name>
  <summary>Stream games and other applications from another PC</summary>
  <description>
    <p>
      TemStream allows you to stream games and other applications from a powerful
      Windows or Mac computer to your local device over your home network or the internet.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Stream your entire game library from your PC</li>
      <li>Support for up to 4K HDR at 120 fps</li>
      <li>Hardware video decoding for low latency</li>
      <li>Custom gamepad mappings</li>
      <li>Surround sound support</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.temstream.TemStream.desktop</launchable>
  <url type="homepage">https://temstream.com</url>
